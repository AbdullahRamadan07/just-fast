# Copy to .env for docker compose. Never commit real secrets.

# Database
DB_USERNAME=justfast
DB_PASSWORD=justfast
MYSQL_ROOT_PASSWORD=root-dev-only

# Origin customers use (the frontend). Used for payment return URLs.
PUBLIC_BASE_URL=http://localhost:8080

# Store administrator created on startup
ADMIN_EMAIL=admin@justfast.local
ADMIN_PASSWORD=change-me-admin

# One currency / one shipping region / flat shipping fee
STORE_CURRENCY=USD
STORE_SHIPPING_COUNTRY=US
STORE_SHIPPING_FEE=5.00

# Payments: "sandbox" (built-in simulated hosted checkout) or "stripe" (Stripe Checkout, use test keys)
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=local-sandbox-secret-change-me
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
